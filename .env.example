# Gemini (Google AI Studio)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# MCP transport (current design)
MCP_TRANSPORT=stdio

# Local output directory (reserved for next phases)
OUTPUT_DIR=output

# Phase 1 (API/Worker)
API_ADDR=:8080
API_BASE_URL=http://127.0.0.1:8080
JOBS_DIR=output/jobs
WORKER_POLL_SECONDS=3
JOB_MAX_ATTEMPTS=2

# Phase 2 (Frontend)
FRONTEND_ADDR=:3000
